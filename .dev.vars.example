# Copy this file to .dev.vars for local development. Never commit .dev.vars.
# In production, set secrets with:  npx wrangler secret put BETTER_AUTH_SECRET

# Signs session cookies. Must be at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public address of the site. Leave empty locally; set it in production (wrangler.jsonc "vars" or dashboard).
APP_URL=
