{
  "name": "buildquote",
  "version": "1.0.0",
  "private": true,
  "description": "BuildQuote — construction quotation generator",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply buildquote --local",
    "db:migrate:remote": "wrangler d1 migrations apply buildquote --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "better-auth": "^1.7.26",
    "hono": "^4.13.19",
    "lucide-react": "^1.76.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
