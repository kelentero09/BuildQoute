{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buildquote",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },

  // The React app is served as static assets; only /api/* reaches the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buildquote",
      // Replace with the id printed by: npx wrangler d1 create buildquote
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret configuration. Secrets go in .dev.vars locally and `wrangler secret put` in production.
  "vars": {
    // Public address of the site, e.g. https://buildquote.example.com. Required in production.
    "APP_URL": "",
    // Public site token from Cloudflare Web Analytics (optional; leave empty to disable the beacon).
    "CF_WEB_ANALYTICS_TOKEN": ""
  }
}
